{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "clonersource",
  "version": "1.0.0",
  "builtin-baseline": "4b77da7fed37817f124936239197833469f1b9a8",
  "features": {
    "dsqt-registry": {
      "description": "Use the published DsQt package with selected modules",
      "dependencies": [
        {
          "name": "dsqt",
          "default-features": false,
          "features": [],
          "version>=": "0.3.0-waffles.1"
        }
      ]
    },
    "dsqt-local": {
      "description": "Use the local DsQt package with selected modules",
      "dependencies": [
        {
          "name": "dsqt",
          "default-features": false,
          "features": []
        }
      ]
    }
  },
  "dependencies": [
    {
      "name": "tomlplusplus",
      "version>=": "3.4.0"
    },
    {
      "name": "glm",
      "version>=": "1.0.1"
    }
  ]
}
