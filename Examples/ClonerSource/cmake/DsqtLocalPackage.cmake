# Opt-in local DsQt package support. Include BEFORE project(), because the
# vcpkg toolchain installs manifest dependencies while project() runs.
if(NOT DSQT_USE_LOCAL_VCPKG)
    return()
endif()
if(NOT CMAKE_HOST_WIN32)
    message(FATAL_ERROR "The local DsQt package currently supports Windows x64 MSVC only.")
endif()
if(NOT DSQT_LOCAL_PACKAGE_ROOT)
    if(NOT "$ENV{DSQT_LOCAL_PACKAGE_ROOT}" STREQUAL "")
        set(_dsqt_local_default "$ENV{DSQT_LOCAL_PACKAGE_ROOT}")
    elseif(NOT "$ENV{LOCALAPPDATA}" STREQUAL "")
        set(_dsqt_local_default "$ENV{LOCALAPPDATA}/DsQt/vcpkg")
    else()
        message(FATAL_ERROR "LOCALAPPDATA is unavailable. Set DSQT_LOCAL_PACKAGE_ROOT to a completed local package.")
    endif()
    set(DSQT_LOCAL_PACKAGE_ROOT "${_dsqt_local_default}" CACHE PATH "Local DsQt package or publication store" FORCE)
endif()
file(REAL_PATH "${DSQT_LOCAL_PACKAGE_ROOT}" _dsqt_package_root)
set(_dsqt_default_file "${_dsqt_package_root}/dsqt-local-default.json")
if(EXISTS "${_dsqt_default_file}")
    file(READ "${_dsqt_default_file}" _dsqt_default_json)
    string(JSON _dsqt_default_format ERROR_VARIABLE _dsqt_format_error GET "${_dsqt_default_json}" formatVersion)
    string(JSON _dsqt_default_root ERROR_VARIABLE _dsqt_root_error GET "${_dsqt_default_json}" packageRoot)
    if(_dsqt_format_error OR _dsqt_root_error OR NOT _dsqt_default_format EQUAL 1 OR NOT IS_ABSOLUTE "${_dsqt_default_root}")
        message(FATAL_ERROR "Invalid local DsQt default at ${_dsqt_default_file}. Rebuild with build_and_install.bat -vcpkg -qt <version>.")
    endif()
    file(REAL_PATH "${_dsqt_default_root}" _dsqt_package_root)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_dsqt_default_file}")
endif()
set(_dsqt_metadata "${_dsqt_package_root}/dsqt-local-package.json")
if(NOT EXISTS "${_dsqt_metadata}")
    message(FATAL_ERROR "No completed local DsQt package at ${_dsqt_package_root}. Run build_and_install.bat -vcpkg -qt <version> first.")
endif()
file(READ "${_dsqt_metadata}" _dsqt_json)
string(JSON _dsqt_format GET "${_dsqt_json}" formatVersion)
if(NOT _dsqt_format EQUAL 1)
    message(FATAL_ERROR "Unsupported local DsQt package metadata format: ${_dsqt_format}")
endif()
foreach(_field qtKit qtVersion triplet builtinBaseline packageVersion)
    string(JSON _dsqt_${_field} GET "${_dsqt_json}" ${_field})
endforeach()
foreach(_file
        "${_dsqt_qtKit}/lib/cmake/Qt6/Qt6Config.cmake"
        "${_dsqt_package_root}/overlay/dsqt/portfile.cmake"
        "${_dsqt_package_root}/triplets/${_dsqt_triplet}.cmake")
    if(NOT EXISTS "${_file}")
        message(FATAL_ERROR "Local DsQt package input is missing: ${_file}. Rebuild the local package at its intended path.")
    endif()
endforeach()
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/vcpkg.json" _dsqt_app_manifest)
string(JSON _dsqt_app_baseline GET "${_dsqt_app_manifest}" builtin-baseline)
if(NOT _dsqt_app_baseline STREQUAL _dsqt_builtinBaseline)
    message(FATAL_ERROR "Application and local DsQt builtin-baseline differ. Align the manifests before building so both use compatible dependencies.")
endif()
# Changing kit or package root in an existing build can retain stale Qt module
# cache entries. Source updates at the same root/kit are safe to reconfigure.
set(_dsqt_selection "${_dsqt_package_root}|${_dsqt_qtKit}|${_dsqt_triplet}")
if(DEFINED DSQT_LOCAL_PACKAGE_SELECTION AND NOT DSQT_LOCAL_PACKAGE_SELECTION STREQUAL _dsqt_selection)
    message(FATAL_ERROR "The local DsQt package location or Qt kit changed. Reconfigure with cmake --fresh --preset ninja-vcpkg-local.")
endif()
set(DSQT_LOCAL_PACKAGE_SELECTION "${_dsqt_selection}" CACHE INTERNAL "Configured local DsQt package")
set(DSQT_LOCAL_QT_VERSION "${_dsqt_qtVersion}")
set(CMAKE_PREFIX_PATH "${_dsqt_qtKit}" CACHE STRING "Exact local-package Qt kit" FORCE)
set(Qt6_DIR "${_dsqt_qtKit}/lib/cmake/Qt6" CACHE PATH "Exact local-package Qt config" FORCE)
set(VCPKG_TARGET_TRIPLET "${_dsqt_triplet}" CACHE STRING "Local DsQt triplet" FORCE)
set(VCPKG_INSTALLED_DIR "${CMAKE_BINARY_DIR}/vcpkg_installed" CACHE PATH "Application's own dependency installation" FORCE)
list(PREPEND VCPKG_OVERLAY_PORTS "${_dsqt_package_root}/overlay")
list(PREPEND VCPKG_OVERLAY_TRIPLETS "${_dsqt_package_root}/triplets")
list(APPEND VCPKG_MANIFEST_FEATURES dsqt-local)
foreach(_list VCPKG_OVERLAY_PORTS VCPKG_OVERLAY_TRIPLETS VCPKG_MANIFEST_FEATURES)
    list(REMOVE_DUPLICATES ${_list})
    set(${_list} "${${_list}}" CACHE STRING "Local DsQt package configuration" FORCE)
endforeach()
# Resolve only the application's vcpkg copy, never a registered Documents/DsQt
# installation. The file is checked after project() has run vcpkg install.
set(Dsqt_DIR "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/share/dsqt" CACHE PATH "Application's packaged DsQt" FORCE)
set(DSQT_QML_IMPORT_PATH "${Dsqt_DIR}/qml" CACHE PATH "Packaged DsQt QML metadata" FORCE)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${_dsqt_metadata}" "${_dsqt_package_root}/overlay/dsqt/vcpkg.json")
message(STATUS "Local DsQt ${_dsqt_packageVersion}: Qt ${_dsqt_qtVersion}, ${_dsqt_triplet}")
