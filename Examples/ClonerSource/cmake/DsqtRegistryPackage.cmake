# Registry configuration must precede project(): vcpkg installs dependencies there.
if(DSQT_USE_REGISTRY_VCPKG AND DSQT_USE_LOCAL_VCPKG)
    message(FATAL_ERROR "Select either the registry or local DsQt package preset, not both.")
endif()
if(NOT DSQT_USE_REGISTRY_VCPKG)
    return()
endif()
if(NOT CMAKE_HOST_WIN32)
    message(FATAL_ERROR "The DsQt registry package currently supports Windows x64 MSVC only.")
endif()
if(DEFINED DSQT_LOCAL_PACKAGE_SELECTION)
    message(FATAL_ERROR "This build directory previously used a local DsQt package. Use the registry preset's own build directory or configure with --fresh.")
endif()
# An overlay could silently replace the published DsQt recipe. Keep registry
# builds explicit; use the local-package preset when testing a source overlay.
if(VCPKG_OVERLAY_PORTS OR NOT "$ENV{VCPKG_OVERLAY_PORTS}" STREQUAL "")
    message(FATAL_ERROR "Remove VCPKG_OVERLAY_PORTS for a registry build, or select ninja-vcpkg-local.")
endif()
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/vcpkg-configuration.json" _dsqt_registry_config)
string(JSON _dsqt_registry_overlay_count ERROR_VARIABLE _dsqt_registry_overlay_error
    LENGTH "${_dsqt_registry_config}" overlay-ports)
if(NOT _dsqt_registry_overlay_error AND _dsqt_registry_overlay_count GREATER 0)
    message(FATAL_ERROR "Remove overlay-ports from vcpkg-configuration.json for a registry build, or select ninja-vcpkg-local.")
endif()
if(NOT DSQT_REGISTRY_QT_VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        OR DSQT_REGISTRY_QT_VERSION VERSION_LESS "6.12.0")
    message(FATAL_ERROR "Select an exact Qt version >= 6.12.0 with DSQT_REGISTRY_QT_VERSION.")
endif()
set(DSQT_REGISTRY_QT_ROOT "C:/Qt" CACHE PATH "Qt online-installer root for the registry package")
file(TO_CMAKE_PATH "${DSQT_REGISTRY_QT_ROOT}" _dsqt_registry_qt_root)
set(_dsqt_registry_kit "${_dsqt_registry_qt_root}/${DSQT_REGISTRY_QT_VERSION}/msvc2022_64")
foreach(_file bin/qmake.exe lib/cmake/Qt6/Qt6Config.cmake
        lib/cmake/Qt6CanvasPainter/Qt6CanvasPainterConfig.cmake)
    if(NOT EXISTS "${_dsqt_registry_kit}/${_file}")
        message(FATAL_ERROR "Incomplete Qt kit: ${_dsqt_registry_kit}/${_file}")
    endif()
endforeach()
string(REPLACE "." "-" _dsqt_registry_version_slug "${DSQT_REGISTRY_QT_VERSION}")
set(_dsqt_registry_triplet "x64-windows-qt${_dsqt_registry_version_slug}")
set(_dsqt_registry_selection "${_dsqt_registry_kit}|${_dsqt_registry_triplet}")
if(DEFINED DSQT_REGISTRY_PACKAGE_SELECTION AND NOT DSQT_REGISTRY_PACKAGE_SELECTION STREQUAL _dsqt_registry_selection)
    message(FATAL_ERROR "The registry package's Qt kit changed. Reconfigure with --fresh to clear cached Qt module paths.")
endif()
set(DSQT_REGISTRY_PACKAGE_SELECTION "${_dsqt_registry_selection}" CACHE INTERNAL "Configured registry DsQt kit")

# Keep these bytes in step with Library/vcpkg/New-DsqtTriplet.ps1. Identical
# triplets let package producers and consumers share vcpkg's binary cache.
set(_dsqt_registry_triplet_text [=[
# DsQt triplet - x64 Windows, MSVC 2022, Qt @DSQT_REGISTRY_QT_VERSION@
#
# Generated by Library/vcpkg/New-DsqtTriplet.ps1.
#
# vcpkg's ABI hash includes the text of this file, so DSQT_QT_VERSION below is
# what gives this Qt kit its own slot in the binary cache. DsQt is compiled once
# per (version x compiler x kit) and reused from then on. Editing this file
# invalidates that cache entry, which is the intended behaviour.

set(VCPKG_TARGET_ARCHITECTURE x64)
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE dynamic)

# --- Per-port linkage -------------------------------------------------------
# toml++ is a private implementation detail of Dsqt::Core and is linked
# statically, so there is no tomlplusplus.dll to deploy and no dllimport
# requirement pushed onto anyone who links Dsqt::Core.
#
# The CRT stays dynamic: the official Qt kits are built against it.
if(PORT STREQUAL "tomlplusplus")
    set(VCPKG_LIBRARY_LINKAGE static)
endif()

# --- Qt kit -----------------------------------------------------------------
# Must match a kit installed by the Qt online installer / Maintenance Tool.
# The dsqt port fails with an explanatory message if the kit is missing, rather
# than quietly falling back to another version.
set(DSQT_QT_VERSION "@DSQT_REGISTRY_QT_VERSION@")
set(DSQT_QT_ROOT    "@_dsqt_registry_qt_root@")
set(DSQT_QT_ARCH    "msvc2022_64")
]=])
set(_dsqt_registry_triplets "${CMAKE_BINARY_DIR}/dsqt-triplets")
file(MAKE_DIRECTORY "${_dsqt_registry_triplets}")
file(CONFIGURE OUTPUT "${_dsqt_registry_triplets}/${_dsqt_registry_triplet}.cmake"
    CONTENT "${_dsqt_registry_triplet_text}" @ONLY NEWLINE_STYLE UNIX)
list(PREPEND VCPKG_OVERLAY_TRIPLETS "${_dsqt_registry_triplets}")
list(APPEND VCPKG_MANIFEST_FEATURES dsqt-registry)
foreach(_list VCPKG_OVERLAY_TRIPLETS VCPKG_MANIFEST_FEATURES)
    list(REMOVE_DUPLICATES ${_list})
    set(${_list} "${${_list}}" CACHE STRING "Registry DsQt package configuration" FORCE)
endforeach()
set(VCPKG_TARGET_TRIPLET "${_dsqt_registry_triplet}" CACHE STRING "Registry DsQt triplet" FORCE)
set(VCPKG_INSTALLED_DIR "${CMAKE_BINARY_DIR}/vcpkg_installed" CACHE PATH "Application's own dependency installation" FORCE)
set(CMAKE_PREFIX_PATH "${_dsqt_registry_kit}" CACHE STRING "Exact registry-package Qt kit" FORCE)
set(Qt6_DIR "${_dsqt_registry_kit}/lib/cmake/Qt6" CACHE PATH "Exact registry-package Qt config" FORCE)
set(Dsqt_DIR "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/share/dsqt" CACHE PATH "Application's registry DsQt" FORCE)
set(DSQT_QML_IMPORT_PATH "${Dsqt_DIR}/qml" CACHE PATH "Packaged DsQt QML metadata" FORCE)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/vcpkg-configuration.json")
message(STATUS "Registry DsQt: Qt ${DSQT_REGISTRY_QT_VERSION}, ${_dsqt_registry_triplet}. The registry baseline must contain the preview required by vcpkg.json.")
